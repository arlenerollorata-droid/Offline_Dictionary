{
  "expo": {
    "name": "Offline Dictionary",
    "slug": "offline-dictionary-trie",
    "scheme": "offlinedictionary",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.offlinedictionary.trie"
    },
    "splash": {
      "backgroundColor": "#FAFAFA",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53cf20f1-25f0-49f1-8a04-582148be709c"
      }
    }
  }
}
