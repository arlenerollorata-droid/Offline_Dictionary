{
  "expo": {
    "name": "Offline Dictionary",
    "slug": "offline-dictionary-trie",
    "scheme": "offlinedictionary",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.offlinedictionary.trie"
    },
    "splash": {
      "backgroundColor": "#fff",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
